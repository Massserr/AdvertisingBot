{
  "name": "advertising-bot-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "prisma:generate": "pnpm --dir apps/api prisma:generate",
    "prisma:migrate": "pnpm --dir apps/api prisma:migrate",
    "db:push": "pnpm --dir apps/api db:push",
    "db:seed": "pnpm --dir apps/api db:seed"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
